@version v1
# =============================================================================
#  SML 优势展示 — SNOWARE Markup Language
# =============================================================================
#  本文件是**可直接解析**的真实 SML（不是示意伪码）。用任意实现验证：
#
#    Rust :  sml::parse_file("showcase.sml")
#    Lua  :  local v = Sml.load(text)
#    JS   :  import { parse } from "./js/sml.mjs"; parse(text)
#    C    :  sml_parse(text, err, sizeof err)
#
#  下方每一节都对照等价的 JSON，说明 SML 解决了什么问题。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 注释 —— JSON 不支持注释，配置无法自解释；YAML 只有 #，但 SML 的 #
#    在引号内不会被误判为注释（见 2 的 streetAddress）。
# -----------------------------------------------------------------------------

# 2. 引号可选 —— 裸词即字符串。JSON 里每个键和字符串都必须加双引号。
#    SML: state: NY          JSON: "state": "NY"
firstName: John
age: 27

# 3. 块冒号可省 —— `address { }` 等价于 `address: { }`
address {
    streetAddress: "21 2nd Street"   # 含空格才需要引号
    city: "New York"
    state: NY                         # 裸词，无需引号
    postalCode: 10021
}

# 4. 数组分隔灵活 —— 逗号可选、可换行。JSON 必须写逗号，且末尾多一个逗号即报错。
phoneNumbers: [
    { type: home   number: "212 555-1234" }
    { type: office number: "646 555-4567" }
]

# 标量数组同样免逗号
tags: [ urgent internal q3 ]

# -----------------------------------------------------------------------------
# 5. 片段继承 —— 消除重复配置。JSON/YAML 需要靠「锚点+合并键」这类
#    非通用扩展，且跨文件通常失效；SML 是原生一等特性。
#    `@name { }` 定义，`&name` 以**值**形式引用并就地展开。
# -----------------------------------------------------------------------------
@base {
    region: cn-north-1
    tls: true
    timeout: 30
}

server {
    # 字段级展开：把 @base 的内容注入到当前块的 region 字段
    region: &base
    port: 8080
}

# -----------------------------------------------------------------------------
# 6. 词中 @ 无需转义 —— 邮箱可直接裸写。
#    YAML 里 `a@b.c` 虽可用，但 `@` 在 YAML 是保留指示符（需写在正确位置）；
#    JSON 则必须整体加引号。SML 只在**词首**把 @ 当片段标记。
# -----------------------------------------------------------------------------
contact {
    to: a@b.c
    cc: ops@example.com
    # 含空格（显示名）才需要引号
    from: "sal <sal@mail.swebase.cn>"
}

# -----------------------------------------------------------------------------
# 7. 环境变量内联 —— 敏感信息（密钥/口令）不落盘，部署时注入。
#    JSON/YAML 均无此能力，只能把明文写进文件，或依赖外部模板引擎。
# -----------------------------------------------------------------------------
credentials {
    apiKey: $env.RESEND_API_KEY
    # 环境变量不存在时解析为空串，不会导致解析失败
    optionalToken: $env.MISSING_VAR
}

# -----------------------------------------------------------------------------
# 8. 类型自识别 —— 无需引号包裹数字/布尔/null，解析后即为对应类型。
#    JSON 数字与字符串靠引号区分，但**无法表达**「这个字符串恰好长得像数字」
#    的场景；SML 用引号显式表达字符串。
# -----------------------------------------------------------------------------
typed {
    enabled: true
    retired: false
    placeholder: null
    count: 42
    ratio: 1.5
    sci: 1.5e3
    # 显式加引号 = 字符串，哪怕内容像数字
    postalCodeString: "10021"
}

# -----------------------------------------------------------------------------
# 9. 嵌套块 —— 层级结构与 YAML 相当，但**不依赖缩进**。
#    YAML 的缩进敏感是配置出错与「复制粘贴后行为突变」的主要来源；
#    SML 以花括号定界，缩进只为可读性。
# -----------------------------------------------------------------------------
database {
    primary {
        host: db1.internal
        port: 5432
    }
    replica {
        host: db2.internal
        port: 5432
    }
}
