@version v1
# =============================================================================
#  SML 契约（Contract）展示 —— 可选的 schema 校验层
# =============================================================================
#  SML 本身是纯数据格式（与 JSON/YAML 同层），只有 7 种值类型。
#  契约是在此之上的**可选**一层，用来给块加上：
#    结构体约束、枚举、默认值、数值区间、组合嵌套、严格性控制
#
#  ⚠ 语言支持状态（见 TODO.md）：
#      Rust : ✅ 已支持（组合 / 严格模式 / 嵌套 均已实现）
#      C    : ⏳ 待办
#      JS   : ⏳ 待办
#      Lua  : ⏳ 待办
#
#  不使用契约时解析行为完全不变，因此**向后兼容**。
#
#  验证（Rust）：
#    sml::parse_file("showcase_contract.sml")
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 契约定义 —— `@contract Name { ... }`（定义本身不进解析结果）
#
#    类型：str / int / num / bool / any / [T]（数组）/ enum [ ... ]
#          / 另一个契约名（**组合**）
#    修饰符：required（默认）/ optional / default <值> / min <数> / max <数>
# -----------------------------------------------------------------------------
@contract Address {
    city: str
    country: str default CN
    zip: str optional
}

@contract Server {
    host: str                              # 必填（默认 required）
    port: int default 5432                 # 缺失时填 5432
    tls: bool default false
    tags: [str] optional                   # 可选，且元素须为字符串
    status: enum [ active standby retired ] # 取值必须来自该列表
    weight: num min 0 max 100               # 数值区间（含端点）
    # 组合：字段的类型是另一个契约（而非继承）
    address: Address
}

# -----------------------------------------------------------------------------
# 2. 组合（Composition）—— 字段的类型是另一个契约
#
#    与「继承」的区别：继承是复用/共享字段定义，组合是「这个字段的值必须
#    符合另一个契约」。组合可多层嵌套，且不引入任何新 token——直接写契约名。
# -----------------------------------------------------------------------------
database {
    primary {
        @is Server
        host: db1.internal
        status: active
        weight: 80
        tags: [ prod critical ]
        address { city: Beijing }       # country 省略 -> 填默认 CN
    }

    replica {
        @is Server
        host: db2.internal
        port: 5433
        tls: true
        status: standby
        weight: 20
        address { city: Shanghai  zip: "200120" }
    }
}

# -----------------------------------------------------------------------------
# 3. 严格模式 —— 默认严格，放宽必须显式写 loose
#
#    严格：契约未声明的字段会被拒绝（能立即发现 `prot` 这类拼写错误）
#    宽松：`@contract Name loose { }` 才允许额外字段
# =============================================================================
# -----------------------------------------------------------------------------
@contract Metrics loose {   # 显式允许未声明字段（如各业务自定义的指标）
    latency: num min 0
}

metrics {
    @is Metrics
    latency: 12.5
    customCounter: 7        # loose 下允许；严格模式会报错
}

# -----------------------------------------------------------------------------
# 4. 能力对照
# -----------------------------------------------------------------------------
#   能力              | JSON / YAML            | SML 契约
#   -------------------|------------------------|-----------------------------
#   结构体字段与类型   | 需外挂 JSON Schema     | 内置 @contract
#   枚举               | JSON Schema 的 enum    | enum [ ... ]
#   默认值             | 无（须应用侧补齐）      | default <值>（解析时填充）
#   数值区间           | JSON Schema 的 min/max | min / max
#   必填校验           | JSON Schema 的 required| required（默认）
#   嵌套结构           | JSON Schema 的 $ref    | 组合：字段类型写契约名
#   禁止额外字段       | additionalProperties   | 默认严格；loose 显式放宽
#
#   校验发生在**解析期**：违反契约直接返回错误，而不是等到应用侧才发现。
#
#   以下写法都会被拒绝（取消注释即可看到报错）：
#     port: "eighty"          -> 类型应为 int
#     status: deleted         -> 不在 enum 列表内
#     weight: 150             -> 大于上界 100
#     tags: [ a 2 ]           -> 数组元素应为 str
#     prot: 5432              -> 严格模式：字段未声明（拼错了 port）
#     address: not-a-block    -> 组合字段必须是块
#     address { }             -> 子契约的必填字段 city 缺失
#     （省略 host）           -> 必填字段缺失
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 5. 契约 vs 片段（易混淆，故并列说明）
# -----------------------------------------------------------------------------
#   `@base { }` + `&base` ：**片段**——复用数据，把一组字段展开进来
#   `@contract` + `@is`   ：**契约**——约束数据，校验结构并补默认值
#
#   片段是「值的复用」，契约是「形状的约束」，两者正交、可同时使用。
#   契约之间用**组合**而非继承：不共享字段定义，而是「字段的类型是另一个契约」。
# -----------------------------------------------------------------------------
