{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行扩展（F5）",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"]
    },
    {
      "name": "运行扩展（禁用其它扩展，排查冲突）",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions"
      ]
    }
  ]
}
