{
  "name": "sml-lang",
  "displayName": "SML (SNOWARE Markup Language)",
  "description": "%sml.description%",
  "version": "0.4.3",
  "publisher": "snoware",
  "icon": "images/icon.png",
  "license": "MulanPSL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/snoware/sml.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "sml",
    "snoware",
    "markup",
    "configuration"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:sml",
    "workspaceContains:**/*.sml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sml.reloadHighlight",
        "title": "%sml.reloadHighlight.title%"
      },
      {
        "command": "sml.setHighlightMode",
        "title": "%sml.setHighlightMode.title%"
      },
      {
        "command": "sml.createHighlightConfig",
        "title": "%sml.createHighlightConfig.title%"
      },
      {
        "command": "sml.specialHighlight",
        "title": "%sml.specialHighlight.title%"
      },
      {
        "command": "sml.clearSpecialHighlight",
        "title": "%sml.clearSpecialHighlight.title%"
      },
      {
        "command": "sml.applySpecialColor",
        "title": "%sml.applySpecialColor.title%"
      },
      {
        "command": "sml.selectIconTheme",
        "title": "%sml.selectIconTheme.title%"
      },
      {
        "command": "sml.selfCheck",
        "title": "%sml.selfCheck.title%"
      }
    ],
    "languages": [
      {
        "id": "sml",
        "aliases": [
          "SML",
          "sml"
        ],
        "extensions": [
          ".sml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sml",
        "scopeName": "source.sml",
        "path": "./syntaxes/sml.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "sml-icons",
        "label": "%sml.iconThemes.smlIcons%",
        "path": "./fileicons/sml-icon-theme.json"
      },
      {
        "id": "sml-icons-seti",
        "label": "%sml.iconThemes.smlIconsSeti%",
        "path": "./fileicons/seti/sml-seti-icon-theme.json"
      }
    ],
    "configurationDefaults": {
      "[sml]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.tabCompletion": "on"
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "sml.specialHighlight",
          "when": "editorHasSelection && editorLangId == sml",
          "group": "navigation@9"
        },
        {
          "command": "sml.clearSpecialHighlight",
          "when": "sml.specialHighlightActive",
          "group": "navigation@10"
        },
        {
          "command": "sml.applySpecialColor",
          "when": "editorLangId == sml",
          "group": "navigation@9"
        },
        {
          "command": "sml.selfCheck",
          "when": "editorLangId == sml",
          "group": "navigation@11"
        }
      ]
    },
    "configuration": {
      "title": "SML",
      "properties": {
        "sml.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%sml.diagnostics.enabled.description%"
        },
        "sml.highlight.mode": {
          "type": "string",
          "enum": [
            "full",
            "minimal",
            "off"
          ],
          "default": "full",
          "description": "%sml.highlight.mode.description%"
        },
        "sml.highlight.configFile": {
          "type": "string",
          "default": "HL-cfg.sml",
          "description": "%sml.highlight.configFile.description%"
        },
        "sml.specialHighlight.include": {
          "type": "string",
          "default": "**/*.sml",
          "description": "%sml.specialHighlight.include.description%"
        },
        "sml.specialHighlight.caseSensitive": {
          "type": "boolean",
          "default": true,
          "description": "%sml.specialHighlight.caseSensitive.description%"
        },
        "sml.specialHighlight.wholeWord": {
          "type": "boolean",
          "default": false,
          "description": "%sml.specialHighlight.wholeWord.description%"
        }
      }
    }
  },
  "scripts": {
    "sync-parser": "python scripts/sync-parser.py",
    "package": "npm run sync-parser && npx --yes @vscode/vsce package",
    "install-local": "npm run package && code --install-extension sml-lang-0.4.3.vsix --force"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
