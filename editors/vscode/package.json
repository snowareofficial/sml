{
  "name": "sml-lang",
  "displayName": "SML (SNOWARE Markup Language)",
  "description": "SML 语言支持：语法高亮、错误提示、补全、悬浮说明与格式化",
  "version": "0.4.2",
  "publisher": "snoware",
  "icon": "images/icon.png",
  "license": "MulanPSL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/snoware/sml.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "sml",
    "snoware",
    "markup",
    "configuration"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:sml",
    "workspaceContains:**/*.sml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sml.reloadHighlight",
        "title": "SML: 重载自定义高亮配置"
      },
      {
        "command": "sml.setHighlightMode",
        "title": "SML: 设置高亮强度（全部 / 极简 / 关闭）"
      },
      {
        "command": "sml.createHighlightConfig",
        "title": "SML: 创建 HL-cfg.sml 高亮配置"
      },
      {
        "command": "sml.specialHighlight",
        "title": "SML: 特别高亮选中词（当前工作区）"
      },
      {
        "command": "sml.clearSpecialHighlight",
        "title": "SML: 清除特别高亮"
      },
      {
        "command": "sml.selfCheck",
        "title": "SML: 自检（悬浮 / 跳转 / 高亮没反应时先跑这个）"
      }
    ],
    "languages": [
      {
        "id": "sml",
        "aliases": [
          "SML",
          "sml"
        ],
        "extensions": [
          ".sml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sml",
        "scopeName": "source.sml",
        "path": "./syntaxes/sml.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "sml-icons",
        "label": "SML Icons（仅 .sml）",
        "path": "./fileicons/sml-icon-theme.json"
      },
      {
        "id": "sml-icons-seti",
        "label": "SML Icons + Seti（其他文件沿用 Seti 图标）",
        "path": "./fileicons/seti/sml-seti-icon-theme.json"
      }
    ],
    "configurationDefaults": {
      "[sml]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.tabCompletion": "on"
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "sml.specialHighlight",
          "when": "editorHasSelection && editorLangId == sml",
          "group": "navigation@9"
        },
        {
          "command": "sml.clearSpecialHighlight",
          "when": "sml.specialHighlightActive",
          "group": "navigation@10"
        },
        {
          "command": "sml.selfCheck",
          "when": "editorLangId == sml",
          "group": "navigation@11"
        }
      ]
    },
    "configuration": {
      "title": "SML",
      "properties": {
        "sml.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "编辑 .sml 文件时实时显示解析错误"
        },
        "sml.highlight.mode": {
          "type": "string",
          "enum": [
            "full",
            "minimal",
            "off"
          ],
          "default": "full",
          "description": "高亮强度：full=全部；minimal=只保留注释/字符串/数字；off=全部关闭"
        },
        "sml.highlight.configFile": {
          "type": "string",
          "default": "HL-cfg.sml",
          "description": "自定义高亮配置文件路径（相对工作区根目录），不存在时静默跳过"
        },
        "sml.specialHighlight.include": {
          "type": "string",
          "default": "**/*.sml",
          "description": "「特别高亮」的搜索范围（glob；默认只搜 .sml，遵循 files.exclude）"
        },
        "sml.specialHighlight.caseSensitive": {
          "type": "boolean",
          "default": true,
          "description": "「特别高亮」是否区分大小写"
        },
        "sml.specialHighlight.wholeWord": {
          "type": "boolean",
          "default": false,
          "description": "「特别高亮」是否只匹配完整词（按 SML 标识符字符类判边界）"
        }
      }
    }
  },
  "scripts": {
    "sync-parser": "python scripts/sync-parser.py",
    "package": "npm run sync-parser && npx --yes @vscode/vsce package",
    "install-local": "npm run package && code --install-extension sml-lang-0.4.2.vsix --force"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
