{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SML",
  "scopeName": "source.sml",
  "fileTypes": ["sml", "swl", "smlex"],
  "comment": "三类符号分色：声明（@contract / @片段定义）用 entity.name.* 定义色；调用（@is / &片段引用）用 variable.other.member 引用色；指令（@version / @feature / @when / @for / @weak* / include / import）用 keyword.control 指令色。类型与修饰符对齐 Rust（support.type.primitive / storage.modifier）。键名与名字支持中文。版本集按 Edition 模型（数字 / 代号 / dev 三槽位）、特性名按 <域>.<名>、块头 featag 用 ! 记号；语法层只做词法着色，不判定语义与端支持范围。",
  "patterns": [
    { "include": "#comment" },
    { "include": "#contract-block" },
    { "include": "#type-block" },
    { "include": "#directive" },
    { "include": "#featag" },
    { "include": "#string" },
    { "include": "#envvar" },
    { "include": "#fragment-ref" },
    { "include": "#constant" },
    { "include": "#number" },
    { "include": "#array" },
    { "include": "#key" },
    { "include": "#array-bare-block" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "name": "comment.line.number-sign.sml", "match": "#.*$" },
        { "name": "comment.line.double-dash.sml", "match": "--.*$" },
        { "name": "comment.line.double-slash.sml", "match": "//.*$" },
        { "name": "comment.block.slash-star.sml", "begin": "/\\*", "end": "\\*/" },
        { "name": "comment.block.underscore-star.sml", "begin": "_\\*", "end": "\\*_" }
      ]
    },

    "contract-block": {
      "comment": "契约声明：@contract Name [strict|warn|loose] { ... }。类型/修饰符高亮只在契约体内生效，业务数据区的同名裸词不会被误判。",
      "begin": "(@contract)\\s+([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)?(?:\\s+(strict|warn|loose))?\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.other.declaration.sml" },
        "2": { "name": "entity.name.type.sml" },
        "3": { "name": "storage.modifier.sml" },
        "4": { "name": "punctuation.definition.block.sml" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.definition.block.sml" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#contract-block" },
        { "include": "#featag-decl" },
        { "include": "#contract-field" },
        { "include": "#contract-enum" },
        { "include": "#contract-type" },
        { "include": "#contract-type-ref" },
        { "include": "#contract-modifier" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#constant" },
        { "include": "#punctuation" }
      ]
    },
    "type-block": {
      "comment": "@type name: X { ... } 自定义模式类型。块内启用模式语言的作用域：关键字、内置字符类、量词各自着色。",
      "begin": "(@type)\\s+(name)(:)\\s*([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)?\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.other.declaration.sml" },
        "2": { "name": "keyword.other.argument.sml" },
        "3": { "name": "punctuation.separator.key-value.sml" },
        "4": { "name": "entity.name.type.sml" },
        "5": { "name": "punctuation.definition.block.sml" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.definition.block.sml" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#type-block" },
        { "include": "#pattern-brace" },
        { "include": "#pattern-class" },
        { "include": "#pattern-keyword" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#constant" },
        { "include": "#punctuation" }
      ]
    },
    "pattern-brace": {
      "comment": "模式体内的平衡花括号：内联块 { 名: 年, 类: 数字 } 的 } 此前会提前终止外层 @type 块。由本规则消化嵌套的 {}，保证 @type 作用域覆盖到真正的收尾 }。",
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.definition.block.sml" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.definition.block.sml" } },
      "patterns": [
        { "include": "#pattern-brace" },
        { "include": "#pattern-class" },
        { "include": "#pattern-keyword" },
        { "include": "#punctuation" },
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#number" }
      ]
    },
    "pattern-keyword": {
      "comment": "模式语言关键字（中英等价）。any-of 置于最前，避免被 any 抢先匹配。",
      "match": "(?<!\\w)(any\\-of|序列|类|任一|组|用|直到|次|可选|名|最小|最大|字面|seq|class|alt|group|use|until|times|repeat|optional|name|min|max|lit|literal)(?!\\w)",
      "name": "keyword.other.pattern.sml"
    },
    "pattern-class": {
      "comment": "内置字符类取值（中英等价）：与 Rust 原始类型同色。",
      "match": "(?<!\\w)(数字|字母|空白|字|任意|digit|alpha|space|word|any)(?!\\w)",
      "name": "support.type.primitive.sml"
    },
    "featag-decl": {
      "comment": "契约内 featag 声明：!name / !name: 类型 / !name: 类型 -> 落点；!any 与 !strict-paths 是契约级开关。落点只穿对象与 [n] 下标。",
      "patterns": [
        {
          "comment": "带落点的声明：`!name[: 类型][ default 值] -> 路径`。三件事各自成组 —— `:` 是分隔符、类型是类型色、`default` 是修饰符、其后的值是裸值（不上色），路径是引用色。此前整个 `冒号之后、-> 之前` 被当成类型段，于是 `!density: str default compact` 里的 `default compact` 一起被染成类型色。",
          "match": "(!)([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)(?:\\s*(:)\\s*([^\\n>:]*?))?(?:\\s+(default|optional|required|min|max)\\b\\s*([^\\n>]*?))?\\s*(->)\\s*([A-Za-z_\\u4e00-\\u9fa5][\\w.\\[\\]\\-\\u4e00-\\u9fa5]*)",
          "captures": {
            "1": { "name": "keyword.operator.featag.sml" },
            "2": { "name": "entity.name.tag.featag.sml" },
            "3": { "name": "punctuation.separator.key-value.sml" },
            "4": { "name": "support.type.primitive.sml" },
            "5": { "name": "storage.modifier.sml" },
            "7": { "name": "keyword.operator.featag-target.sml" },
            "8": { "name": "variable.other.member.sml" }
          }
        },
        {
          "comment": "无落点的声明 / 契约级开关：!name、!any、!strict-paths",
          "match": "(!)([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)",
          "captures": {
            "1": { "name": "keyword.operator.featag.sml" },
            "2": { "name": "entity.name.tag.featag.sml" }
          }
        }
      ]
    },
    "contract-field": {
      "comment": "契约字段名：与 Rust struct 字段同色。支持中文键名。",
      "match": "([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)\\s*(?=:)",
      "captures": { "1": { "name": "variable.other.member.sml" } }
    },
    "contract-enum": {
      "comment": "enum [ a b c ] 与 enum(a,b,c)：enum 与括号为类型色，括号内为枚举成员。",
      "match": "\\b(enum)\\s*([\\[(])([^\\])]*)([\\])])",
      "captures": {
        "1": { "name": "support.type.primitive.sml" },
        "2": { "name": "support.type.primitive.sml" },
        "3": { "name": "variable.other.enummember.sml" },
        "4": { "name": "support.type.primitive.sml" }
      }
    },
    "contract-type": {
      "comment": "字段类型：与 Rust 原始类型同色。",
      "match": "\\b(str|int|num|bool|any|array|enum)\\b",
      "name": "support.type.primitive.sml"
    },
    "contract-type-ref": {
      "comment": "契约字段位里的**自定义类型名**（`t: 时刻`，`时刻` 由 `@type name:` 注册）。内置类型由 #contract-type 先吃掉，故这条只兜住剩下的词；着色与 `@type` 声明处一致（entity.name.type）—— 此前这类名字整段无色，看起来像「类型没写对」。",
      "match": "(:)\\s*(?!(?:str|int|num|bool|any|array|enum)\\b)([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)(?=\\s|$|\\})",
      "captures": {
        "1": { "name": "punctuation.separator.key-value.sml" },
        "2": { "name": "entity.name.type.sml" }
      }
    },
    "contract-modifier": {
      "comment": "约束修饰符：与 Rust 的 pub/mut 同色。from-featag 声明该键只能由 featag 落点写入。",
      "match": "\\b(from-featag|required|optional|default|min|max)\\b",
      "name": "storage.modifier.sml"
    },
    "featag": {
      "comment": "块头 featag 区：!name（无参）与 name[值, …]（带参），以逗号终止。只在 @feature enable type.featag 后有意义；编辑器只着色、不判定端支持范围。",
      "patterns": [
        {
          "comment": "带参 featag：!obey[1, 2] —— `!` 是 featag 的唯一标记（每一项都要写），名字为标签色，方括号沿用数组标点色",
          "match": "(?<![=\\w])(!)([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)(\\[)",
          "captures": {
            "1": { "name": "keyword.operator.featag.sml" },
            "2": { "name": "entity.name.tag.featag.sml" },
            "3": { "name": "punctuation.definition.array.sml" }
          }
        },
        {
          "comment": "无参 featag：!critical —— 排除 != / !! 这类运算符形态",
          "match": "(?<![=!\\w])(!)([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)",
          "captures": {
            "1": { "name": "keyword.operator.featag.sml" },
            "2": { "name": "entity.name.tag.featag.sml" }
          }
        }
      ]
    },

    "directive": {
      "comment": "指令与片段定义。@is 是契约「调用」，契约名用引用色以区别于 @contract 处的「声明」色。",
      "patterns": [
        {
          "comment": "调用契约（类型标注形式）：@is type(契约名) —— 与 `@is 契约名` 等价。type 为标注关键字色，契约名为引用色。必须排在裸名形式之前，否则 `type` 会被整块当作契约名。",
          "match": "(@is)\\s+(type)(\\()([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)(\\))",
          "captures": {
            "1": { "name": "keyword.control.sml" },
            "2": { "name": "keyword.other.declaration.sml" },
            "3": { "name": "punctuation.definition.type.sml" },
            "4": { "name": "variable.other.member.sml" },
            "5": { "name": "punctuation.definition.type.sml" }
          }
        },
        {
          "comment": "调用契约：@is Name —— 可多份（`@is A, B`，每份可带 loose/warn/strict）。整行尾部一次吃掉，再由内层 patterns 分色（契约名=引用色、严格度=修饰符色、逗号=分隔符色）。此前只认第一个名字，`@is A, B` 的 B 全无色。",
          "match": "(^\\s*)(@is)\\b([^\\n]*)",
          "captures": {
            "2": { "name": "keyword.control.sml" },
            "3": {
              "patterns": [
                { "match": "\\b(loose|warn|strict)\\b", "name": "storage.modifier.sml" },
                { "match": "[A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*", "name": "variable.other.member.sml" },
                { "match": ",", "name": "punctuation.separator.sml" }
              ]
            }
          }
        },
        {
          "comment": "弱声明族指令：@weakbind / @weakdata / @weakdoc —— 需 @feature enable type.weak；只登记旁路数据、不进主树。",
          "match": "(@)(weakbind|weakdata|weakdoc)\\b(?:\\s+([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*))?",
          "captures": {
            "1": { "name": "keyword.control.sml" },
            "2": { "name": "keyword.control.weak.sml" },
            "3": { "name": "variable.other.member.sml" }
          }
        },
        {
          "comment": "契约级依赖声明：@requires NAME { NAME … }（Rust 单端；JS 端明确拒绝 E-CONTRACT-018）。",
          "match": "(@)(requires)\\b(?:\\s+([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*))?",
          "captures": {
            "1": { "name": "keyword.control.sml" },
            "2": { "name": "keyword.control.requires.sml" },
            "3": { "name": "variable.other.member.sml" }
          }
        },
        {
          "comment": "版本声明：@version <版本集> [\"代号\"] [dev] —— 连写 50 是规范形式，vN / N / N.M 与代号是等价名，dev 只能置于末尾。",
          "match": "(@version)\\s+(v?[0-9]+(?:\\.[0-9]+)?|\"[^\"]+\")(?:\\s+(\"[^\"]+\"))?(?:\\s+(dev)\\b)?",
          "captures": {
            "1": { "name": "keyword.control.sml" },
            "2": { "name": "constant.other.version.sml" },
            "3": { "name": "constant.other.codename.sml" },
            "4": { "name": "storage.modifier.sml" }
          }
        },
        {
          "comment": "特性开关：@feature base vN | enable|disable|mode|whitelist|blacklist <name>[, <name>…] —— 新增特性一律 <域>.<名>，老名保持平铺。",
          "match": "(@feature)\\s+(base|enable|disable|mode|whitelist|blacklist)\\s+([\\w.\\-]+(?:\\s*,\\s*[\\w.\\-]+)*)",
          "captures": {
            "1": { "name": "keyword.control.sml" },
            "2": { "name": "keyword.other.sml" },
            "3": { "name": "entity.name.type.sml" }
          }
        },
        {
          "comment": "条件：@when $env.X == \"1\"",
          "begin": "(@when)\\b",
          "beginCaptures": { "1": { "name": "keyword.control.sml" } },
          "end": "$",
          "patterns": [
            { "include": "#envvar" },
            { "name": "keyword.operator.comparison.sml", "match": "(==|!=)" },
            { "name": "string.quoted.double.sml", "match": "\"[^\"]*\"" },
            { "name": "constant.language.sml", "match": "\\b(true|false)\\b" }
          ]
        },
        {
          "comment": "循环：@for var in a b c { ... }",
          "match": "(@for)\\s+([A-Za-z_][\\w]*)\\s+(in)\\b",
          "captures": {
            "1": { "name": "keyword.control.sml" },
            "2": { "name": "variable.other.loop-variable.sml" },
            "3": { "name": "keyword.other.sml" }
          }
        },
        {
          "comment": "import/include 行（含部分引用 { a, b } 与 as ns）",
          "begin": "^\\s*(@?import|@?include)\\b",
          "beginCaptures": { "1": { "name": "keyword.control.import.sml" } },
          "end": "$",
          "patterns": [
            {
              "match": "\\{([^}]*)\\}",
              "captures": { "1": { "name": "variable.other.member.sml" } }
            },
            { "match": "\\b(as|in)\\b", "name": "keyword.other.sml" },
            { "match": "\"([^\"]*)\"", "name": "string.quoted.double.sml" },
            { "match": "[A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*", "name": "entity.name.namespace.sml" }
          ]
        },
        {
          "comment": "片段声明 @name：@ 为声明符、名为定义色。@ 前不得是单词字符——否则邮箱 a@b.c 里的 @b、ops@example.com 里的 @example 会被误判成片段声明",
          "match": "(?<![\\w])(@)([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)",
          "captures": {
            "1": { "name": "keyword.other.declaration.sml" },
            "2": { "name": "entity.name.function.fragment.sml" }
          }
        }
      ]
    },

    "string": {
      "name": "string.quoted.double.sml",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.sml", "match": "\\\\." },
        { "name": "variable.other.interpolation.sml", "match": "\\$\\{[^}]*\\}" },
        { "comment": "字符串内的环境变量引用：$env.NAME 同样着色，便于在引号串里一眼看出嵌入了环境变量", "include": "#envvar" }
      ]
    },
    "envvar": {
      "name": "variable.other.env.sml",
      "match": "\\$env\\.[A-Za-z_][\\w]*"
    },
    "fragment-ref": {
      "comment": "片段调用 &name：& 为引用运算符、名为引用色。& 前不得是单词字符——避免 a&b、ops&dev 之类被误判成引用。",
      "match": "(?<![\\w])(&)([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)",
      "captures": {
        "1": { "name": "keyword.operator.reference.sml" },
        "2": { "name": "variable.other.member.sml" }
      }
    },
    "constant": {
      "name": "constant.language.sml",
      "match": "\\b(true|false|null)\\b"
    },
    "number": {
      "name": "constant.numeric.sml",
      "match": "(?<![\\w-])-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?"
    },
    "array-bare-block": {
      "comment": "裸块头 `type [featag 区] [契约词…] [块名] {`：数组位置（`[ A B item { … } ]`）与键位置同形。**两件事两色** —— 块头里的契约词（首词的类型词 + 其余被应用的契约）一律 `variable.other.member`（与 `@is` 引用同色，声明处才是 `entity.name.type`），块名 `entity.name.section`。语言层「首个未命中契约表的词是块名」，编辑器没有契约表，故按**位置**取：逗号之后、featag 区之后、或最后一个词。普通标量数组（`[ a b ]`）不含 `{`，不会被这条吃掉。",
      "patterns": [
        {
          "comment": "块名：紧跟 featag 项之后、`{` 之前的那一个词（`A !t tagged {`）。变长后顾断言只认 `!tag ` 之后那一词 —— 不带上这条，`a: b {` 的 `b` 会被误当契约词。",
          "match": "(?<=![A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*\\s)([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)\\s*(?=\\{)",
          "captures": { "1": { "name": "entity.name.section.sml" } }
        },
        {
          "comment": "块名：**逗号之后**那个词（块头三段式的第三段 `Service !t[4], prod {`）。必须排在下一条之前 —— 下一条的后顾断言在「逗号后带空格」时也会命中，把块名当契约词。",
          "match": "(,)\\s*([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)\\s*(?=\\{)",
          "captures": {
            "1": { "name": "punctuation.separator.sml" },
            "2": { "name": "entity.name.section.sml" }
          }
        },
        {
          "comment": "多词块头：前面的词都是**块头契约词**（首词是类型词，其余是被应用的契约）—— 一律用引用色 `variable.other.member`，与 `@is A, B` 同色；**最后一个才是块名** `entity.name.section`。契约名在**声明处**（`@contract A`）才用 `entity.name.type`，应用处一律引用色。",
          "match": "(?:^|(?<=\\[)|(?<=,))\\s*((?:[A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*\\s+)+)([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)\\s*(?=[^\\n]*\\{)",
          "captures": {
            "1": { "name": "variable.other.member.sml" },
            "2": { "name": "entity.name.section.sml" }
          }
        },
        {
          "comment": "单词块头：只有类型词、没有块名（`A {`）—— 它是**被应用的契约**，用引用色（与 `@is A` 一致），不是声明色。",
          "match": "(?:^|(?<=\\[)|(?<=,))\\s*([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)\\s*(?=[^\\n]*\\{)",
          "captures": { "1": { "name": "variable.other.member.sml" } }
        }
      ]
    },
    "key": {
      "comment": "数据区键名：支持中文。两个分支 —— ① 行首键（允许缩进）；② 同行后续键 / 内联对象键（紧跟 `{` 或 `,`，且其后是 `:`）。此前只有分支 ①（整个 match 被 ^\\s* 锚在行首），于是 `web { host: a, port: 8080 }` 里只有行首那个词着色，同行的 host / port 全无色 —— 真实 Oniguruma 引擎实测 `host✗ port✗`，即「字段组合（同一行多字段 / 内联对象）」着不上色。",
      "patterns": [
        {
          "comment": "解析产出的保留元数据键：__featags / __type / __name / __args。正文手写这些键在 v5 会被显式拒绝。",
          "match": "\\b(__featags|__type|__name|__args)\\b",
          "name": "variable.other.meta.sml"
        },
        {
          "match": "^\\s*([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)\\s*(?=:|\\s*\\{)",
          "captures": { "1": { "name": "variable.other.member.sml" } }
        },
        {
          "comment": "逗号之后的键（`{ host: a, port: 8080 }`）—— `(?=:)` 是为了不把数组里的 `a, b` 这类值误当键；逗号本身给分隔符色。此前 `{` 与 `,` 共用一个捕获组、组 1 无名字，于是数组里裸块的 `{` 被吞掉且不上色。",
          "match": "(,)\\s*([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "punctuation.separator.sml" },
            "2": { "name": "variable.other.member.sml" }
          }
        },
        {
          "comment": "内联对象的第一个键（`[ { a: 1 } ]`）—— `{` 给块标点色。",
          "match": "(\\{)\\s*([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "punctuation.definition.block.sml" },
            "2": { "name": "variable.other.member.sml" }
          }
        },
        {
          "comment": "无逗号分隔的后续键（SML 分隔符可省）：词前是空白、其后是 `:`。两道保险：① `(?<!:)` 要求这个空白**不是紧跟在冒号后**（否则 `url: https://x` 里的 `https` 会被误当键）；② `(?!/)` 排除 `: //`。语料 `address { city: Shanghai  zip: \"200120\" }` 就属这一类。",
          "match": "(?<!:)\\s+([A-Za-z_\\u4e00-\\u9fa5][\\w.\\-\\u4e00-\\u9fa5]*)\\s*(?=:(?!/))",
          "captures": { "1": { "name": "variable.other.member.sml" } }
        }
      ]
    },
"array": {
      "comment": "数组上下文 `[ … ]`：存在的唯一理由是区分「词后跟 `{`」的两种身份 —— 块里 `a {` 是嵌套块（键名色），数组里 `A {` 是裸块头（类型色）。上下文内先试裸块头、再试键，故 `xs: [ A { … } ]` 不会再被键规则吃掉。",
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.definition.array.sml" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.definition.array.sml" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#array-bare-block" },
        { "include": "#featag" },
        { "include": "#string" },
        { "include": "#envvar" },
        { "include": "#fragment-ref" },
        { "include": "#constant" },
        { "include": "#number" },
        { "include": "#key" },
        { "include": "#array" },
        { "include": "#punctuation" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.definition.block.sml", "match": "[{}]" },
        { "name": "punctuation.definition.array.sml", "match": "[\\[\\]]" },
        { "name": "punctuation.separator.key-value.sml", "match": ":" },
        { "name": "punctuation.separator.sml", "match": "," }
      ]
    }
  }
}
