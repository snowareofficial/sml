//------------------------------------------------
//  .smlb v1 / Binary Template for 010 Editor
//  SPDX-License-Identifier: MulanPSL-2.0
//
//  用法：打开 showcase.smlb（或 showcase-zstd.smlb）后
//        Templates → Open Template… → 选本文件 → Run。
//
//  这份模板刻意**只解析容器骨架**：段体里的 canonical 节点树是值层的线格式，
//  让容器保持「只靠长度就能跳过不认识的段」这条不变量 —— 模板也不去解释它。
//  manifest 段体里能看到 "primary" / "hash_id" / "sha256" 等 ASCII 字符串，
//  这就是「manifest 用 SML 自描述」在十六进制视图里的样子。
//------------------------------------------------

LittleEndian();

typedef struct {
    char    magic[4];            // "SWSB"
    ushort  edition;             // 低字节 major，高字节 minor
    ubyte   fmt;                 // 字节布局补丁位（v1 = 0）
    ubyte   hdr_len;             // 本版 = 40
    uint64  seg_table_off;       // 段表偏移；v1 = hdr_len
    uint32  seg_count;
    ushort  flags;               // 位 0 = 段体对齐粒度（0: 8 B / 1: 4096 B）
    ushort  reserved1;
    uint64  tail_off;            // T4 尾部表预留，v1 = 0
    uint64  reserved2;
} SmlbHeader;                    // = 40 B

typedef struct {
    ubyte   seg_id;              // 0x01 VALUE / 0x02 STRTAB / 0x04 MANIFEST / 0x10 FRAMES / 0x20 EMBED / 0x7f 未知
    ubyte   comp;                // 0 = none, 1 = zstd (§20)
    ubyte   enc;                 // 0 = none, 0x10 = AES-256-GCM
    ushort  flags;
    uint32  len;                 // **落盘**长度（压缩/加密之后）
    ubyte   sha256[32];          // 覆盖「落盘字节」—— 不是解压后的字节
} SegmentEntry;                  // = 41 B

typedef struct {
    char    magic[8];            // "SMLTRLR1"
    uint32  layer_count;
    uint64  last_layer_off;
    ubyte   head_hash[32];
    ubyte   reserved[12];
} Trailer;                       // = 64 B，固定在 EOF

// ---------- 文件头 ----------
FSeek(0);
SmlbHeader hdr;

// 不用自定义函数，避免不同 010 Editor 版本对「local 函数」的语法差异；
// 对齐一律内联成一行算术。
local uint64 granule = (hdr.flags & 1) ? 4096 : 8;

// ---------- 段表 ----------
FSeek(hdr.seg_table_off);
SegmentEntry segs[hdr.seg_count];

// ---------- 段体：位置靠「表尾对齐 → 逐段走长度」算出来 ----------
// ⚠️ 段表项里**没有偏移字段**，这是刻意的：表里没有位置，位置就不可能与内容不一致。
local uint64 off = ((hdr.seg_table_off + hdr.seg_count * 41 + granule - 1) / granule) * granule;
local int i;
for (i = 0; i < hdr.seg_count; i++) {
    FSeek(off);
    // 用动态数组把段体标出来；010 Editor 会在十六进制视图里高亮这一段。
    ubyte body[segs[i].len];
    off = ((off + segs[i].len + granule - 1) / granule) * granule;
}

// ---------- 尾部层链（T4）：只在有 Trailer 时出现 ----------
// 三个样例里只有 showcase.smlb 带层链；先探魔数再解析，避免把普通段体当 Trailer。
local uint64 fsize = FileSize();
if (fsize >= 64) {
    FSeek(fsize - 64);
    uint32 probe;                     // "SMLT" 的小端 u32 = 0x544C4D53
    if (probe == 0x544C4D53) {
        FSeek(fsize - 64);
        Trailer trailer;

        // 反向链：从 last_layer_off 往前走。层记录 =
        //   len:u32 ‖ prev_off:u64 ‖ reserved:u32 ‖ canonical Value 字节。
        // 追加时只往 EOF 后面加，旧字节一个都不改（不变量 3）。
        if (trailer.last_layer_off > 0 && trailer.last_layer_off < fsize) {
            FSeek(trailer.last_layer_off);
            uint32 layer_len;
            uint64 prev_off;
            uint32 layer_reserved;
            ubyte layer_body[layer_len];
        }
    }
}
