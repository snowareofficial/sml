@version v1
# =============================================================================
#  深度防御规则集 —— 支付网关 pgw-prod
#
#  分层顺序：边界 NET → 身份 IDC → 应用 APP → 数据 DAT → 外发 EGR。
#  本文件是**可直接解析**的真实 SML，不是示意伪码：
#    · @type 模式类型在解析期匹配编号 / 网段 / 时间窗 / 指纹的字面格式；
#    · @contract + @is 在解析期校验结构，并把省略的字段按 default 回填；
#    · @片段 复用处置基线，片段只给一部分字段，剩下的仍由契约补齐。
#
#  验证：Rust  sml::parse_file("examples/deep-security.sml")
#        JS    import { parse } from "./js/sml.mjs"; parse(text)
#  注：@type 模式类型由 Rust / JS 实现（C / C++ / Lua 会明确报错，不静默放过）；
#      组合子块（处置 / 处置结果）的默认值回填以 Rust 参考实现为准 —— 实测 JS
#      不递归填充组合字段，跨端共享时不要依赖这一层填充。
# =============================================================================

# -----------------------------------------------------------------------------
# 一、模式类型：值的字面格式由解析器匹配，不靠应用侧二次校验
# -----------------------------------------------------------------------------

# 规则编号：DS-<层>-<四位序号>
@type name: 规则编号 {
    序列: [
        { 字面: "DS-" }
        { 名: 层, 任一: [ NET IDC APP DAT EGR ] }
        { 字面: "-" }
        { 名: 序号, 类: 数字, 次: 4 }
    ]
}

@type name: 时刻 {
    序列: [
        { 名: 时, 类: 数字, 次: 2 }
        { 字面: ":" }
        { 名: 分, 类: 数字, 次: 2 }
    ]
}

# 生效时段：起止时刻，如 02:00~05:00
@type name: 时间窗 {
    序列: [
        { 名: 起, 用: 时刻 }
        { 字面: "~" }
        { 名: 止, 用: 时刻 }
    ]
}

@type name: 日期 {
    序列: [
        { 名: 年, 类: 数字, 次: 4 }
        { 字面: "-" }
        { 名: 月, 类: 数字, 次: 2 }
        { 字面: "-" }
        { 名: 日, 类: 数字, 次: 2 }
    ]
}

# 事件号：<日期>/<六位流水>，如 2026-10-12/000187
@type name: 事件号 {
    序列: [
        { 名: 日, 用: 日期 }
        { 字面: "/" }
        { 名: 流水, 类: 数字, 次: 6 }
    ]
}

# 网段：点分四段 + 掩码，每段 1~3 位
@type name: 网段 {
    序列: [
        { 名: 段一, 类: 数字, 次: "1-3" }
        { 字面: "." }
        { 名: 段二, 类: 数字, 次: "1-3" }
        { 字面: "." }
        { 名: 段三, 类: 数字, 次: "1-3" }
        { 字面: "." }
        { 名: 段四, 类: 数字, 次: "1-3" }
        { 字面: "/" }
        { 名: 掩码, 类: 数字, 次: "1-2" }
    ]
}

# 证据指纹：sha256 摘要，定长 64 位
@type name: 证据指纹 {
    序列: [
        { 字面: "sha256:" }
        { 名: 摘要, 类: 字, 次: 64 }
    ]
}

@type name: 时间戳 {
    序列: [
        { 名: 日期, 用: 日期 }
        { 字面: " " }
        { 名: 时刻, 用: 时刻 }
        { 字面: ":" }
        { 名: 秒, 类: 数字, 次: 2 }
    ]
}

# -----------------------------------------------------------------------------
# 二、契约：形状约束 + 默认值自填充
#    省略即取默认值；未声明的字段被严格模式直接拒绝（拼写错无处藏）
# -----------------------------------------------------------------------------

@contract 处置 strict {
    方式:      enum [ 限流 二次验证 隔离 封禁 ] default 限流     # 命中后的处置手段
    封禁时长:  int default 600 min 0 max 86400                  # 秒；0 = 不自动解封
    通知:      [str] optional                                   # 通知渠道，省略为默认群
    留存证据:  bool default true
    可申诉:    bool default true
}

@contract 安全规则 strict {
    编号:        规则编号
    名称:        str
    层:          enum [ 边界 身份 应用 数据 外发 ]
    表达式:      str
    动作:        enum [ 放行 观察 告警 阻断 ] default 观察
    严重级:      enum [ 低 中 高 严重 ] default 中
    命中阈值:    int default 5 min 1 max 100000                 # 统计窗口内命中次数
    统计窗口:    int default 60 min 1 max 3600                  # 秒
    生效时段:    时间窗 default "00:00~23:59"
    误报率上限:  num default 0.02 min 0 max 1                   # 超过则自动降级为观察
    来源:        [str] optional                                 # 限定来源网段，省略为全量
    # （数组元素类型目前只支持 str / int / num / bool / any，故这里的网段格式不校验）
    豁免:        [str] optional                                 # 豁免对象（租户 / 账号）
    处置:        处置                                           # 组合：子块按 处置 回填
    依据:        str default "基线-深度防御-v3"
    启用:        bool default true
}

@contract 上报凭据 strict {
    地址: str
    令牌: str
}

@contract 例外 strict {
    规则编号: 规则编号
    对象:     str
    理由:     str
    有效期:   日期
    审批人:   str
}

@contract 事件 strict {
    编号:     事件号
    命中规则: 规则编号
    指纹:     证据指纹
    发生时刻: 时间戳
    来源网段: 网段
    处置结果: 处置
    已复核:   bool default false
}

@contract 策略集 strict {
    版本:     str
    生效日:   日期
    责任人:   str
    默认动作: enum [ 放行 观察 告警 阻断 ] default 观察
    灰度比例: num default 0.1 min 0 max 1
    凭据:     上报凭据
    规则:     any                                   # 规则体逐条 @is 安全规则
}

# -----------------------------------------------------------------------------
# 三、处置基线片段：只写"与默认不同"的那部分，其余仍由 处置 契约补齐
# -----------------------------------------------------------------------------

@基线处置 {
    方式: 限流
    封禁时长: 600
}

@严格处置 {
    方式: 封禁
    封禁时长: 86400
    通知: [ 安全运营群 值班电话 ]
}

@取证处置 {
    方式: 隔离
    留存证据: true
    可申诉: false
}

# -----------------------------------------------------------------------------
# 四、规则集
# -----------------------------------------------------------------------------

策略 {
    @is 策略集
    版本:     "3.2.0"
    生效日:   "2026-10-12"
    责任人:   安全运营组
    默认动作: 观察
    灰度比例: 0.2

    凭据 {
        @is 上报凭据
        地址: "https://soc.internal/ingest"   # URL 必须加引号：// 在 SML 里是行注释
        令牌: $env.SOC_INGEST_TOKEN
    }

    规则: [
        # ---- 边界层 ----
        {
            @is 安全规则
            编号: "DS-NET-0101"
            名称: 单源高频请求
            层: 边界
            表达式: "rate(src_ip, 60s) > 3000"
            动作: 阻断
            严重级: 高
            命中阈值: 1
            处置: &基线处置        # 片段只给两条，剩下的由 处置 契约回填
        }
        {
            @is 安全规则
            编号: "DS-NET-0102"
            名称: 非常规端口探测
            层: 边界
            表达式: "distinct(dst_port) > 200 && proto == tcp"
            动作: 告警
            统计窗口: 300
            来源: [ "10.20.0.0/16" "172.16.4.0/24" ]
            处置: &基线处置
        }

        # ---- 身份层 ----
        {
            @is 安全规则
            编号: "DS-IDC-0201"
            名称: 异地二次登录
            层: 身份
            表达式: "geo_change(account, 1h) && device_new == true"
            严重级: 高
            处置 {
                方式: 二次验证
                封禁时长: 0
            }
        }
        {
            @is 安全规则
            编号: "DS-IDC-0202"
            名称: 特权账号非工单提权
            层: 身份
            表达式: "role >= admin && ticket_id == null"
            动作: 阻断
            严重级: 严重
            命中阈值: 1
            依据: "等保2.0-8.1.4.3"
            处置: &严格处置
        }

        # ---- 应用层 ----
        {
            @is 安全规则
            编号: "DS-APP-0203"
            名称: 注入特征载荷
            层: 应用
            表达式: "payload matches /union|sleep|xp_cmdshell/i"
            动作: 阻断
            严重级: 高
            误报率上限: 0.005
            处置: &取证处置
        }
        {
            @is 安全规则
            编号: "DS-APP-0204"
            名称: 接口越权批量遍历
            层: 应用
            表达式: "status == 403 && rate(uid, 300s) > 120"
            生效时段: "02:00~05:00"      # 只在夜间维护窗生效
            处置: &基线处置
        }

        # ---- 数据层：只写必填项，其余全部自填充 ----
        {
            @is 安全规则
            编号: "DS-DAT-0302"
            名称: 批量导出证件号
            层: 数据
            表达式: "rows(id_card) > 200 && role != dba"
            动作: 阻断
            严重级: 严重
            处置: &严格处置
            # 命中阈值 / 统计窗口 / 生效时段 / 误报率上限 / 依据 / 启用 全部省略，
            # 解析后由 安全规则 契约按 default 补齐
        }

        # ---- 外发层 ----
        {
            @is 安全规则
            编号: "DS-EGR-0401"
            名称: 境外通道外发
            层: 外发
            表达式: "dst_region not in [ CN ] && bytes > 10485760"
            动作: 告警
            严重级: 中
            统计窗口: 600
            处置 { }                  # 空块：四个默认值全部由 处置 契约回填
        }
    ]
}

# -----------------------------------------------------------------------------
# 五、临时例外：走独立契约，避免把一次性豁免混进规则体
# -----------------------------------------------------------------------------

例外: [
    {
        @is 例外
        规则编号: "DS-APP-0203"
        对象: 灰度批次-B7
        理由: 大促压测放行
        有效期: "2026-10-15"
        审批人: 张三
    }
    {
        @is 例外
        规则编号: "DS-NET-0101"
        对象: 压测机-10.20.9.31
        理由: 全链路压测窗口
        有效期: "2026-10-13"
        审批人: 李四
    }
]

# -----------------------------------------------------------------------------
# 六、留档事件：编号 / 指纹 / 时刻同样由模式类型在解析期校验
# -----------------------------------------------------------------------------

事件 {
    @is 事件
    编号: "2026-10-12/000187"
    命中规则: "DS-DAT-0302"
    指纹: "sha256:9f2c41d7a6b8e0c35d1a7f4e2b9c8d6a3f1e0b7c4d9a2f8e5b3c1d7a6f0e4b92"
    发生时刻: "2026-10-12 03:14:07"
    来源网段: "203.0.113.0/24"
    处置结果: &严格处置
}
