# Rust
target/
# 本地校验/验证用构建目录（cargo 验证产物，非源码）
rust/target_verify/
Cargo.lock

# 构建产物
*.sar
out_verify/
out/

# Python
__pycache__/

# 构建/测试临时产物（C / C++ 编译输出与日志）
*.exe
*.txt
# 但保留仓库根的 llms.txt（面向 AI 的引导文件，需进版本库与官网）
!llms.txt
!site/static/llms.txt
*.dll
!logo/*.dll
inc_tmp/

# Dioxus 站点（独立未发布）
site-dioxus/

# Wrangler 运行时缓存与本机日志
site/.wrangler/
site/dev.log
site/build_site.log
site/hugo_server.log
site/hugo_server.err

# 百度翻译 API 凭据（含密钥，切勿提交）
.baidu.env
site/.baidu.env
*.baidu.env

# 临时/调试脚本（非库代码，勿提交）
_du.py
c/build_check.py

# Hugo 生成的站点产物（由 site/content 与 site/static 重新生成，勿提交）
site/public/
# 但保留前端运行必需的静态资源（同源于 site/static 或由构建脚本产出一次）
!site/public/llms.txt
!site/public/sml.mjs
!site/public/sml.svg
!site/public/sml-verify.js
!site/public/.gitkeep

# 报告与打包产物（安全扫描报告、电子书导出等）
swsml-*.zip
sml-book.epub

