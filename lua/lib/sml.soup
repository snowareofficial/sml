-- SPDX-License-Identifier: MulanPSL-2.0
-- lib/sml.soup  (soupkg v1.8)
-- sml = SNOWARE Markup Language：声明式数据/配置格式，定位为 JSON/YAML 的替代品。
--
-- 相对 JSON/YAML 的改进：
--   1) 引号可选：裸词即字符串（JSON 强制引号；YAML 裸词有类型歧义）。
--   2) 块冒号可省：`address { }` 与 `address: { }` 等价（更接近 Caddyfile）。
--   3) 数组分隔灵活：`[ a b c ]`、每行一个、或 `{..}, {..}` 逗号可选。
--   4) 片段继承：`@name { ... }` 定义片段，`&name` 引用（比 YAML anchor 直观）。
--   5) 环境变量内联：`$env.VAR` 在标量值处展开为 os.getenv("VAR")。
--   6) 注释：单行 `#` / `--` / `//`；多行 `/* */` 与 `_* *_`（JSON 不支持）。
--   7) 类型自识别：true/false -> bool，null -> nil，数字 -> number，其余 -> string。
--
-- 语法（与用户给定示例一致）：
--   firstName: John
--   age: 27
--   isAlive: true
--   address:
--   {
--       streetAddress: "21 2nd Street"
--       state: NY
--   }
--   phoneNumbers:
--   [
--       { type: home, number: "212 555-1234" }
--       { type: office, number: "646 555-4567" }
--   ]
--   children: []
--   spouse: null
--
-- API：
--   sml.load(text)      -> value, err   （解析；err 为 nil 表示成功）
--   sml.loads(text)     -> 同 load（别名）
--   sml.dump(value)     -> string        （序列化回 sml 文本，便于校验/round-trip）
--   块（带类型名）表示为 { __type="pool", __name="greeter", ...fields }。

local Sml = {}
Sml.__index = Sml

function Sml.new()
  return setmetatable({}, Sml)
end

------------------------------------------------------------------------------
-- 错误码约定（W10）—— 与 c/sml.h、cpp/sml.hpp 同一口径
--
--   失败消息**以错误码开头**，码与文案之间用一个空格分隔，形如
--       "E-PARSE-001 sml: 未闭合的块（遇到文件结尾，缺少结束符号 }）"
--   码内不含空格，故调用方取「第一个空格之前」的部分即为码：
--       local code = err:match("^(%S+)")
--   码是稳定契约、文案不是（各端措辞可以不同，码相同即同一件事）。
--   码表（唯一事实来源）见 errors/codes.sml。
--
-- ⚠️ `error(msg, 0)` 的 level=0 是**必须**的：Lua 默认会往消息前面插一段位置
--    （"lua/lib/sml.soup:229: ..."），那会把码挤到消息中间，调用方按「首个空格
--    之前」取码就会拿到 "lua/lib/sml.soup:229:" 这种东西 —— 码等于白加。
--    level=0 同时也让 pcall 捕到的消息与抛出的完全一致，外层包装能据此判断
--    「这条已经带码了，别再包一层」。
------------------------------------------------------------------------------
local function fail(code, msg)
  error(code .. " sml: " .. msg, 0)
end

-- 消息是否已经带码（E-XXX-NNN / W-XXX-NNN / I-XXX-NNN 开头）
local function has_code(msg)
  return string.match(msg, "^[EWI]%-%u+%-%d%d%d ") ~= nil
end

------------------------------------------------------------------------------
-- 深度上限（W15）—— 与其它端**同为 128 层**（Rust `MAX_VALUE_DEPTH`、
-- C/C++ `SML_MAX_VALUE_DEPTH`），超限报 `E-LIMIT-001`。
--
-- 计法：**文档根不算一层**（根 = 0 层）。每进一个块（`a { … }`）或一个数组
-- （`k: [ … ]`）层数 +1，进入前判 `depth > MAX_VALUE_DEPTH`。于是
--   `("a { "):rep(128)`（128 层）照常解析；第 129 层起报 E-LIMIT-001。
-- 为什么用**参数**逐层传递而不是一个可变计数器：
--   * 变量计数器必须先加后减，一旦哪个提前 return 漏了减，上限就会随着深度
--     累积而失效；参数在每层栈帧里各自独立，不需要递减，也无从「复位」——
--     而「超限后把深度复位为 0」正是 C/C++ 踩过的坑（复位不会让栈帧退回去，
--     外层循环又从 0 往下钻，「每 128 层一轮」反复压栈，10 万层照样打穿栈）。
--   * 超限时 fail() → error() 会沿 pcall 一路退栈到 Sml.load，中途**没有**
--     任何 protected call 会拦住它，所以不会留下半截树被当成成功返回。
-- 无深度参数的调用：`depth == nil` 会让下面的比较当场报 Lua 错（被 Sml.load
--   的 pcall 兜成 E-PARSE-012）—— 是响的，不是静默放行。**新增递归入口必须
--   一并把 depth 传下去**，否则就是绕过上限（C++ 的纯块嵌套就是这么被打穿的）。
------------------------------------------------------------------------------
local MAX_VALUE_DEPTH = 128

local function enter_depth(depth)
  if depth > MAX_VALUE_DEPTH then
    fail("E-LIMIT-001",
         "嵌套过深（超过 " .. MAX_VALUE_DEPTH .. " 层），疑似递归或恶意输入")
  end
end

------------------------------------------------------------------------------
-- 词法：逐字符扫描，产出 token 流
--   独立 token：{ } [ ] ,
--   引号串：保留内部空格/转义
--   其余按空白分词；`#` 行注释（引号外）
--   冒号 `:` 独立成 token（便于 `key: value` 识别）
------------------------------------------------------------------------------
local function tokenize(text)
  local toks = {}
  local i, n = 1, #text
  local buf = {}
  local function flush()
    if #buf > 0 then
      toks[#toks+1] = table.concat(buf)
      buf = {}
    end
  end
  while i <= n do
    local c = string.sub(text, i, i)
    local c2 = (i < n) and string.sub(text, i + 1, i + 1) or ""
    if c == "#" then
      -- 单行注释：跳到行尾
      while i <= n and string.sub(text, i, i) ~= "\n" do i = i + 1 end
    elseif c == "-" and c2 == "-" then
      -- `--` 单行注释：跳到行尾
      while i <= n and string.sub(text, i, i) ~= "\n" do i = i + 1 end
    elseif c == "/" and c2 == "/" then
      -- `//` 单行注释到行尾
      while i <= n and string.sub(text, i, i) ~= "\n" do i = i + 1 end
    elseif c == "/" and c2 == "*" then
      -- `/*` 多行注释，直到 `*/`
      i = i + 2
      while i <= n do
        local a = string.sub(text, i, i)
        local b = (i < n) and string.sub(text, i + 1, i + 1) or ""
        if a == "*" and b == "/" then i = i + 2; break end
        i = i + 1
      end
    elseif c == "_" and c2 == "*" then
      -- `_*` 多行注释，直到 `*_`
      i = i + 2
      while i <= n do
        local a = string.sub(text, i, i)
        local b = (i < n) and string.sub(text, i + 1, i + 1) or ""
        if a == "*" and b == "_" then i = i + 2; break end
        i = i + 1
      end
    elseif c == '"' then
      flush()
      local j = i + 1
      local qb = {}
      while j <= n do
        local cc = string.sub(text, j, j)
        if cc == '"' then break end
        if cc == "\\" and j < n then
          j = j + 1
          local e = string.sub(text, j, j)
          -- 完整 Lua 风格转义
          if e == "n" then qb[#qb+1] = "\n"
          elseif e == "t" then qb[#qb+1] = "\t"
          elseif e == "r" then qb[#qb+1] = "\r"
          elseif e == "0" then qb[#qb+1] = "\0"
          elseif e == "a" then qb[#qb+1] = "\a"
          elseif e == "b" then qb[#qb+1] = "\b"
          elseif e == "f" then qb[#qb+1] = "\f"
          elseif e == "v" then qb[#qb+1] = "\v"
          elseif e == "\\" then qb[#qb+1] = "\\"
          elseif e == '"' then qb[#qb+1] = '"'
          elseif e == "'" then qb[#qb+1] = "'"
          else qb[#qb+1] = e end  -- 未知转义保留原字符
        else
          qb[#qb+1] = cc
        end
        j = j + 1
      end
      toks[#toks+1] = '"' .. table.concat(qb) .. '"'  -- 保留引号标记便于 coerce 识别
      i = j + 1
    elseif c == "{" or c == "}" or c == "[" or c == "]" or c == "," then
      flush()
      toks[#toks+1] = c
      i = i + 1
    elseif c == "@" then
      -- `@` 仅当位于**词首**时才是片段定义标记（`@base { ... }`）。
      -- 出现在词中间时（典型如邮箱 `a@b.c`）必须作为普通字符保留：
      -- 否则 `a@b.c` 会被切成 "a" + "@" + "b.c"，后半段在解析时被丢弃，
      -- 导致邮箱静默损坏为 "a"。
      if #buf == 0 then
        flush()
        toks[#toks+1] = "@"
      else
        buf[#buf+1] = c
      end
      i = i + 1
    elseif c == ":" then
      flush()
      toks[#toks+1] = ":"
      i = i + 1
    elseif c == " " or c == "\t" or c == "\n" or c == "\r" then
      flush()
      i = i + 1
    else
      buf[#buf+1] = c
      i = i + 1
    end
  end
  flush()
  return toks
end

------------------------------------------------------------------------------
-- 标量识别：引号串 / true / false / null / 数字 / 裸词
------------------------------------------------------------------------------
local deep_copy  -- 前向声明

local function coerce(tok, fragments)
  if tok == nil then return nil end
  -- 引号串（内部支持 $env.VAR 展开）
  if string.sub(tok, 1, 1) == '"' and string.sub(tok, -1) == '"' then
    local inner = string.sub(tok, 2, -2)
    local ev = string.match(inner, "^%$env%.(.+)$")
    if ev then return os.getenv(ev) or "" end
    return inner
  end
  if tok == "true" then return true end
  if tok == "false" then return false end
  if tok == "null" then return nil end
  -- 环境变量内联：$env.VAR（裸词）
  local ev = string.match(tok, "^%$env%.(.+)$")
  if ev then return os.getenv(ev) or "" end
  -- 片段引用：&name
  if string.sub(tok, 1, 1) == "&" then
    local fn = string.sub(tok, 2)
    if fragments and fragments[fn] then
      return deep_copy(fragments[fn])
    end
    return tok  -- 未定义引用原样保留
  end
  -- 数字：支持 123 / 123.5 / .5 / -0.5 / 1e10 / 1E-3
  if string.match(tok, "^%-?%d+%.?%d*$") or
     string.match(tok, "^%-?%.%d+$") or
     string.match(tok, "^%-?%d+%.?%d*[eE][+-]?%d+$") then
    return tonumber(tok)
  end
  return tok
end

deep_copy = function(v)
  if type(v) ~= "table" then return v end
  local t = {}
  for k, val in pairs(v) do
    -- 保留 __type / __name 元数据（片段引用裸块时不丢类型）
    t[k] = deep_copy(val)
  end
  return t
end

------------------------------------------------------------------------------
-- 契约（W20）：`@contract` / `@is`
--
-- 口径照 rust/sml-parse/src/parser.rs 的 parse_field_spec 与
-- rust/sml-contract/src/lib.rs 的 apply_contract，**码与语义逐条对齐**：
--
--   @contract Name [loose|strict] { field: Type mods... }   定义（不进主树）
--   @is Name                                                 在当前块应用
--
-- 类型：  str / int / num / bool / any / [T] / enum [ a b ] / 契约名（组合）
-- 修饰符：optional / required / default <值> / min <数> / max <数>
--
-- 本阶段**刻意不做**（见 W20 报告）：
--   * E-CONTRACT-007（外置类型）与 E-CONTRACT-009（模式类型）：Lua 没有
--     `@type`，那要 sml-pattern 的引擎，另立；
--   * `array [T]`：Rust 的 parse_field_spec 里**没有** `array` 关键字
--     （`array` 会落成契约引用），故本实现不发明该语法。
--
-- 值模型差异（Lua 表不区分数组/对象、nil 即 null），已登记进报告：
--   * `[]` 与 `{}` 解析后都是空表 → 空表对数组类型放行（Rust 会拒 `{}`）；
--   * `x: null` 与「缺 x」在 Lua 里都是 nil → 显式 null 会被当成缺字段。
------------------------------------------------------------------------------

-- 结构记号：出现在「期望标识符」的位置即为语法错误（与 Rust 的 token 集一致）
local STRUCT_CHARS = { ["{"]=true, ["}"]=true, ["["]=true, ["]"]=true,
                       [","]=true, [":"]=true, ["@"]=true }

local function unquote(tok)
  -- 引号串 token 保留了两端引号（便于 coerce 识别），取名/枚举值时要剥掉
  if type(tok) == "string" and #tok >= 2
     and string.sub(tok, 1, 1) == '"' and string.sub(tok, -1) == '"' then
    return string.sub(tok, 2, -2)
  end
  return tok
end

local function is_word_tok(tok)
  return tok ~= nil and not STRUCT_CHARS[tok]
end

-- 「数组形态」：键全为数字（含空表）。Lua 无从区分 `[]` 与 `{}`，见文件头说明。
local function is_list(v)
  if type(v) ~= "table" then return false end
  for k in pairs(v) do
    if type(k) ~= "number" then return false end
  end
  return true
end

-- min / max 的边界字面量（与 Rust parse_spec_number 同口径）：
--   非数字 → E-PARSE-022；nan / inf / 1e400 等非有限 → E-CONTRACT-010。
-- ⚠️ 必须先拦 nan/inf：LuaJIT 的 tonumber("nan") 是 nil，会错报成 E-PARSE-022，
--    而 Rust 的 "nan".parse::<f64>() 是 Ok(NaN)，随后因非有限报 E-CONTRACT-010。
local function looks_number(tok)
  return string.match(tok, "^[+-]?%d+$") ~= nil
      or string.match(tok, "^[+-]?%d+%.%d*$") ~= nil
      or string.match(tok, "^[+-]?%.%d+$") ~= nil
      or string.match(tok, "^[+-]?%d+%.?%d*[eE][+-]?%d+$") ~= nil
      or string.match(tok, "^[+-]?%.%d+[eE][+-]?%d+$") ~= nil
end

local function parse_bound(tok, what)
  if not is_word_tok(tok) then
    fail("E-PARSE-022", "`" .. what .. "` 的边界取值不是数字")
  end
  local mag = string.gsub(string.lower(tok), "^[+-]", "")
  if mag == "nan" or mag == "inf" or mag == "infinity" then
    fail("E-CONTRACT-010", "`" .. what .. "` 的边界必须为有限值，得 `" .. tok .. "`")
  end
  if not looks_number(tok) then
    fail("E-PARSE-022", "`" .. what .. "` 的边界取值不是数字：`" .. tok .. "`")
  end
  local num = tonumber(tok)
  if num == nil or num ~= num or num == math.huge or num == -math.huge then
    fail("E-CONTRACT-010", "`" .. what .. "` 的边界必须为有限值，得 `" .. tok .. "`")
  end
  return num
end

-- 解析一个类型规格 -> spec, next_i
local function parse_type(tokens, i)
  local tok = tokens[i]
  if not is_word_tok(tok) and tok ~= "[" then
    fail("E-PARSE-006", "契约字段的类型期望标识符，得 '" .. tostring(tok) .. "'")
  end
  if tok == "[" then
    i = i + 1
    local el = tokens[i]
    if not is_word_tok(el) then
      fail("E-PARSE-006", "数组元素类型期望标识符，得 '" .. tostring(el) .. "'")
    end
    local elem
    if el == "str" or el == "int" or el == "num" or el == "bool" or el == "any" then
      elem = { kind = el }
    else
      -- 本实现没有 @type / 外置类型注册 → 与 Rust「未注册的数组元素类型」同码
      fail("E-CONTRACT-012", "数组元素类型名未知：`" .. el .. "`")
    end
    i = i + 1
    if tokens[i] == "]" then i = i + 1 end
    return { kind = "array", elem = elem }, i
  end
  if tok == "enum" then
    i = i + 1
    if tokens[i] ~= "[" then
      fail("E-PARSE-023", "`enum` 后须为 [ ... ]")
    end
    i = i + 1
    local vals = {}
    while true do
      local v = tokens[i]
      if v == nil or v == "]" then break end
      -- Rust 对列表内的非取值记号是「跳过」而不是报错（parse_field_spec 的 `_ => next()`）
      if STRUCT_CHARS[v] then i = i + 1
      else vals[#vals + 1] = unquote(v); i = i + 1 end
    end
    if tokens[i] == "]" then i = i + 1 end
    return { kind = "enum", values = vals }, i
  end
  -- `enum(a, b, c)` 兼容式（对齐 Rust parse_field_spec 的 `enum(` 分支）
  local rest = string.match(tok, "^enum%((.*)$")
  if rest then
    local vals = {}
    while true do
      if string.sub(rest, -1) == ")" then
        local last = string.sub(rest, 1, #rest - 1)
        if #last > 0 then vals[#vals + 1] = last end
        break
      end
      vals[#vals + 1] = rest
      if tokens[i + 1] == "," then i = i + 1 end
      local nx = tokens[i + 1]
      if not is_word_tok(nx) then break end
      rest = nx
      i = i + 1
    end
    return { kind = "enum", values = vals }, i + 1
  end
  i = i + 1
  if tok == "str" or tok == "int" or tok == "num" or tok == "bool" or tok == "any" then
    return { kind = tok }, i
  end
  -- 非内置名 → 契约引用（组合）
  return { kind = "contract", ref = unquote(tok) }, i
end

-- 解析单个字段的类型与修饰符 -> spec, next_i
local function parse_field_spec(tokens, i, fragments)
  local spec = { optional = false, has_default = false }
  spec.type, i = parse_type(tokens, i)
  while true do
    local tok = tokens[i]
    if tok == nil then break end
    -- 下一个字段开始：`标识符 :`（Rust 的 is_next_field）
    if is_word_tok(tok) and tokens[i + 1] == ":" then break end
    if tok == "optional" then
      spec.optional = true; i = i + 1
    elseif tok == "required" then
      spec.optional = false; i = i + 1
    elseif tok == "default" then
      i = i + 1
      local dv = tokens[i]
      if not is_word_tok(dv) then
        fail("E-PARSE-021", "`default` 修饰符后缺少取值")
      end
      spec.default = coerce(dv, fragments)
      spec.has_default = true
      i = i + 1
    elseif tok == "min" then
      i = i + 1
      spec.min = parse_bound(tokens[i], "min")
      i = i + 1
    elseif tok == "max" then
      i = i + 1
      spec.max = parse_bound(tokens[i], "max")
      i = i + 1
    else
      -- 未知词（含未注册的外置修饰符）：按下个字段的开始退出
      break
    end
  end
  return spec, i
end

-- 解析契约体（`{ field: Type mods... }`）-> fields, next_i
local function parse_contract_body(tokens, i, fragments)
  local fields = {}
  while true do
    local tok = tokens[i]
    if tok == nil then
      -- 契约体未闭合（缺 `}` 即遇到文件结尾）
      fail("E-PARSE-001", "契约体未闭合（缺少结束符号 }）")
    end
    if tok == "}" then
      i = i + 1
      break
    end
    if tok == "," then
      i = i + 1
    elseif STRUCT_CHARS[tok] then
      fail("E-PARSE-006", "契约字段期望键，得结构记号 '" .. tok .. "'")
    else
      local key = unquote(tok)
      i = i + 1
      if tokens[i] ~= ":" then
        fail("E-PARSE-006", "契约字段 `" .. key .. "` 后须有冒号")
      end
      i = i + 1
      local spec
      spec, i = parse_field_spec(tokens, i, fragments)
      fields[key] = spec
    end
  end
  return fields, i
end

local apply_contract  -- 前向声明（组合字段需要递归回本函数）

-- 校验一个值是否符合字段规格；不符即 fail()（error，沿 pcall 退出）。
-- `fs` 是**字段规格**（`{ type = TypeSpec, min = ..., max = ... }`）：min/max 是
-- 字段级修饰符、不在 TypeSpec 上，故不能只把类型传进来。数组元素递归时用
-- `{ type = elem }` 构造一个（元素不参与 min/max）。
local function check_type(fs, v, contracts)
  local ty = fs.type
  if ty.kind == "any" then
    return
  end
  if ty.kind == "contract" then
    -- 组合：值须为块，递归按被引用契约校验（含填默认值）
    if type(v) ~= "table" then
      fail("E-CONTRACT-008", "字段应为块并按契约 `" .. ty.ref .. "` 校验，实际不是块")
    end
    apply_contract(v, contracts, ty.ref)
    return
  end
  if ty.kind == "array" then
    if not is_list(v) then
      fail("E-CONTRACT-002", "字段类型应为数组，实际不是数组")
    end
    for idx = 1, #v do
      check_type({ type = ty.elem }, v[idx], contracts)
    end
    return
  end
  if ty.kind == "enum" then
    -- 枚举的「取值不在列表内」是独立条件，**不能**与「类型不符」共用码
    local got
    if type(v) == "string" then got = v
    elseif type(v) == "number" and v == math.floor(v) then got = string.format("%d", v)
    else fail("E-CONTRACT-006", "字段取值不在枚举列表内") end
    for _, e in ipairs(ty.values) do
      if e == got then return end
    end
    fail("E-CONTRACT-006", "字段取值 `" .. got .. "` 不在枚举列表内")
  end
  local ok =
       (ty.kind == "str"  and type(v) == "string")
    or (ty.kind == "int"  and type(v) == "number" and v == math.floor(v))
    or (ty.kind == "num"  and type(v) == "number")
    or (ty.kind == "bool" and type(v) == "boolean")
  if not ok then
    fail("E-CONTRACT-002", "字段类型应为 " .. ty.kind .. "，实际为 " .. type(v))
  end
  -- 数值区间：先拒非有限值（NaN 的一切比较均为假，会静默穿透 min/max）
  if fs.min ~= nil or fs.max ~= nil then
    local num
    if type(v) == "number" then num = v end
    if num ~= nil then
      if num ~= num or num == math.huge or num == -math.huge then
        fail("E-CONTRACT-010", "字段的值为非有限数，不可作为数值约束的取值")
      end
      if fs.min ~= nil and num < fs.min then
        fail("E-CONTRACT-005", "字段值小于下界 " .. tostring(fs.min))
      end
      if fs.max ~= nil and num > fs.max then
        fail("E-CONTRACT-005", "字段值大于上界 " .. tostring(fs.max))
      end
    end
  end
end

-- 对块应用契约：严格性检查 + 填默认值 + 逐个字段校验
apply_contract = function(node, contracts, name)
  local c = contracts[name]
  if c == nil then
    fail("E-CONTRACT-001", "未定义的契约 `" .. tostring(name) .. "`")
  end
  if type(node) ~= "table" then
    fail("E-CONTRACT-008", "契约只能应用于块，实际不是块")
  end
  -- 1) 严格性：未声明字段一律拒绝（默认严格；`loose` 显式放宽）。
  --    ⚠️ `__type` / `__name` **不豁免** —— 与 Rust 实测一致：
  --       `@contract A { city: str }` + `x { @is S addr Sub { city: Beijing } }`
  --       （裸块带参数 → 子块含 __type/__name）在 Rust 上报 E-CONTRACT-004
  --       「字段 `addr.__name` 未在契约 `A` 中声明」（用 smltools 实跑确认）。
  --       C++ 侧显式跳过这两个键，与本端不同 —— 本端以 Rust 为准（W20 报告已登记）。
  --       仅当子块是**普通** `key { ... }`（无 type/name 参数）时才没有这两键。
  --    键按名排序遍历：Rust 用 BTreeMap（有序），本端 pairs 无序会让「报哪个键」
  --    随机漂移，排序后与 Rust 一样确定。
  if not c.allow_extra then
    local meta = {}
    for k in pairs(node) do meta[#meta + 1] = k end
    table.sort(meta)
    for _, k in ipairs(meta) do
      if c.fields[k] == nil then
        fail("E-CONTRACT-004",
             "字段 `" .. tostring(k) .. "` 未在契约 `" .. name .. "` 中声明（严格模式）")
      end
    end
  end
  -- 2) 逐字段（按名排序，与 Rust 的 BTreeMap 迭代顺序一致）
  local keys = {}
  for k in pairs(c.fields) do keys[#keys + 1] = k end
  table.sort(keys)
  for _, k in ipairs(keys) do
    local f = c.fields[k]
    local v = node[k]
    if v == nil then
      if f.has_default then
        node[k] = deep_copy(f.default)
      elseif not f.optional then
        fail("E-CONTRACT-003", "字段 `" .. k .. "` 必填但缺失")
      end
    else
      check_type(f, v, contracts)
    end
  end
end

------------------------------------------------------------------------------
-- 语法：递归下降
--   parse_block(tokens, i, closing, fragments, contracts, depth) -> node, next_i
--   node 为 map；遇到 `key:` 后 { -> 子块；[ -> 数组；否则标量。
--   裸块 `type name { }` -> { __type=type, __name=name, ...body }
--   contracts 为契约表（名 -> 契约），由调用方传入并在解析中共用。
--   depth 为当前嵌套层数（文档根 = 0），见上面 MAX_VALUE_DEPTH 一节。
------------------------------------------------------------------------------
local parse_array  -- 前向声明（在 parse_block 内被调用）

local function parse_block(tokens, i, closing, fragments, contracts, depth)
  enter_depth(depth)
  local node = {}
  local n = #tokens
  -- 本块声明的 `@is 契约名`：块结束时应用（Rust 的 applied_contract）
  local pending_is = nil
  -- 统一出口：块正常闭合时先应用契约，再返回。
  -- ⚠️ 必须包住**所有** return 点（`tok == closing` 与 `tok == "}"` 两处提前返回），
  --    否则「块内写了 @is 但契约没被应用」会静默通过。
  local function finish(next_i)
    if pending_is ~= nil then
      apply_contract(node, contracts, pending_is)
    end
    return node, next_i
  end
  -- 同名 key 冲突时提升为数组（避免静默覆盖，见 Bug 1）
  local function set_field(k, v)
    if node[k] == nil then
      node[k] = v
    elseif type(node[k]) == "table" and node[k][1] ~= nil then
      node[k][#node[k]+1] = v   -- 已是数组，追加
    else
      node[k] = { node[k], v }  -- 标量/对象 -> 数组
    end
  end
  while i <= n do
    local tok = tokens[i]
    if tok == closing then
      return finish(i + 1)
    elseif tok == "}" then
      if closing == "}" then
        return finish(i + 1)
      else
        fail("E-PARSE-003", "未匹配的右大括号 '}'（没有与之匹配的开始符号）at token " .. i)
      end
    elseif tok == "]" then
      if closing == "]" then
        return finish(i + 1)
      else
        fail("E-PARSE-003", "未匹配的右方括号 ']'（没有与之匹配的开始符号）at token " .. i)
      end
    end
    if tok == "," then
      i = i + 1  -- 逗号可选分隔符，跳过
    elseif tok == "@" then
      -- 片段定义：@name { ... } 或 @name type args { ... }
      -- （不进主树，存入 fragments；保留 __type/__name 供 & 引用还原）
      i = i + 1
      local fname = tokens[i]; i = i + 1
      if fname == "version" then
        -- `@version vN` 是版本声明指令，不是片段定义（与 Rust/C/JS 对齐）。
        -- 必须特判，否则 version 被当作片段名，其后紧跟的块会被吃掉导致内容丢失
        -- （如 `showcase.sml` 的 `@version v1` + `address { ... }` 整段丢失）。
        local lit = tokens[i]
        if lit == "v1" or lit == "1" then
          -- 当前实现支持 v1（裸词即字符串）
        elseif lit == "v2" or lit == "2" or lit == "v3" or lit == "3" then
          fail("E-FEATURE-004", "版本 `" .. tostring(lit) .. "` 超出本实现接受范围 (v1)")
        else
          fail("E-FEATURE-004", "未知版本 `" .. tostring(lit) .. "`；仅支持 v1")
        end
        i = i + 1
      elseif fname == "contract" then
        -- 契约定义：`@contract Name [loose|strict] { ... }`（不进主树）
        local cname = tokens[i]
        if not is_word_tok(cname) then
          fail("E-PARSE-019", "`@contract` 后须契约名")
        end
        cname = unquote(cname)
        i = i + 1
        -- 可选严格度修饰：`loose` 允许未声明字段；`strict` 与默认等价
        local allow_extra = false
        if tokens[i] == "loose" then allow_extra = true; i = i + 1
        elseif tokens[i] == "strict" then i = i + 1 end
        if tokens[i] ~= "{" then
          fail("E-PARSE-019", "`@contract " .. cname .. "` 后须 `{ ... }`")
        end
        i = i + 1
        local fields
        fields, i = parse_contract_body(tokens, i, fragments)
        contracts[cname] = { name = cname, fields = fields, allow_extra = allow_extra }
      elseif fname == "is" then
        -- 契约应用：`@is Name` 作用于**当前块**，块结束时校验（见 finish）
        local cname = tokens[i]
        if not is_word_tok(cname) then
          fail("E-PARSE-019", "`@is` 后须契约名")
        end
        cname = unquote(cname)
        -- `@is type(契约名)` 与 `@is 契约名` 等价（对齐 Rust 的 unwrap_type_call）
        local inner = string.match(cname, "^type%((.+)%)$")
        if inner and contracts[cname] == nil then cname = inner end
        pending_is = cname
        i = i + 1
      else
        if tokens[i] == ":" then i = i + 1 end
        local ftype, fname_arg = nil, nil
      -- 若紧跟裸块（下一个非 { 非 : 的 token），当作 type name
      if tokens[i] and tokens[i] ~= "{" and tokens[i] ~= ":" then
        ftype = tokens[i]; i = i + 1
        if tokens[i] and tokens[i] ~= "{" and tokens[i] ~= ":" then
          fname_arg = coerce(tokens[i], fragments); i = i + 1
        end
      end
      if tokens[i] == "{" then
        local sub
        sub, i = parse_block(tokens, i + 1, "}", fragments, contracts, depth + 1)
        if ftype then
          sub.__type = ftype
          if fname_arg then sub.__name = fname_arg end
        end
        fragments[fname] = sub
      end
      end
    else
      -- 键位置只接受裸词/引号串。结构记号落在这里是**语法错误**，不能当键名 ——
      -- 否则 `a { { x } }` 会把多余的 `{` 当键、`: 1` 会把 `:` 当键，解析"成功"
      -- 但树是错的（探针实测 `:` 真的成了键名）。与 Rust/JS/C++ 同码（E-PARSE-006）。
      -- 注：`}` `]` `,` `@` 已在上面的分支处理，走不到这里。
      if tok == "{" or tok == "[" or tok == ":" then
        fail("E-PARSE-006",
             "期望键或标识符，得结构记号 '" .. tostring(tok) .. "' at token " .. i)
      end
      -- 读 key
      local key = tok
      i = i + 1
      local colon = false
      if tokens[i] == ":" then colon = true; i = i + 1 end
      local nxt = tokens[i]
      if nxt == "{" then
        local sub
        sub, i = parse_block(tokens, i + 1, "}", fragments, contracts, depth + 1)
        set_field(key, sub)
      elseif nxt == "[" then
        local arr
        arr, i = parse_array(tokens, i + 1, fragments, contracts, depth + 1)
        set_field(key, arr)
      elseif not colon and nxt ~= nil and nxt ~= "}" and nxt ~= "]" and nxt ~= "," then
        -- 裸块：key 为类型，后续 token 直到 { 为参数
        local args = {}
        while tokens[i] and tokens[i] ~= "{" and tokens[i] ~= "}" and tokens[i] ~= "]" and tokens[i] ~= "," do
          args[#args+1] = coerce(tokens[i], fragments)
          i = i + 1
        end
        if tokens[i] == "{" then
          local sub
          sub, i = parse_block(tokens, i + 1, "}", fragments, contracts, depth + 1)
          sub.__type = key
          if #args == 1 then sub.__name = args[1] end
          set_field(key, sub)
        else
          -- 裸块无 body：当作标量串
          set_field(key, coerce(key, fragments))
        end
      else
        -- 标量
        set_field(key, coerce(nxt, fragments))
        i = i + 1
      end
    end
  end
  -- 走到文件结尾仍未见到结束符 → E-PARSE-001。
  -- `closing` 为 nil 只出现在**顶层裸块**（`a: 1\nb: 2` 这种没有外层花括号的），
  -- 到 EOF 收尾是合法的；由 `{` 开启的块（closing == "}"）没闭合就是错。
  -- 原先这里**静默返回残缺的树**：探针实测 `a { b: 1`（文件到此结束）解析"成功"、
  -- 得到 {a={b=1}} —— 用户拿到的是被截断的文档，却没有任何提示。
  if closing ~= nil then
    fail("E-PARSE-001", "未闭合的块（遇到文件结尾，缺少结束符号 '" .. closing .. "'）")
  end
  return finish(i)
end

parse_array = function(tokens, i, fragments, contracts, depth)
  enter_depth(depth)
  local arr = {}
  local n = #tokens
  while i <= n do
    local tok = tokens[i]
    if tok == "]" then
      return arr, i + 1
    elseif tok == "," then
      i = i + 1
    elseif tok == "{" then
      local sub
      sub, i = parse_block(tokens, i + 1, "}", fragments, contracts, depth + 1)
      arr[#arr+1] = sub
    else
      arr[#arr+1] = coerce(tok, fragments)
      i = i + 1
    end
  end
  -- 数组**必须**闭合：parse_array 的两个调用点（parse_block 的 `key: [ ...`、
  -- Sml.load 的顶层 `[ ...`）都先消费过 `[`，所以走到 EOF 一定是没闭合 → E-PARSE-001。
  fail("E-PARSE-001", "未闭合的数组（遇到文件结尾，缺少结束符号 ']'）")
end

------------------------------------------------------------------------------
-- 公开：load（同时支持 Sml.load(text) 静态调用与实例调用）
------------------------------------------------------------------------------
function Sml.load(text)
  if type(text) ~= "string" then
    -- 与 C 的 `sml_parse(NULL)` 同一个格子：坏入参属「走到了不该走的分支」→ E-INTERNAL-001
    return nil, "E-INTERNAL-001 sml: 期望字符串入参，实得 " .. type(text)
  end
  local ok, toks = pcall(tokenize, text)
  if not ok then
    -- tokenize 目前不会抛（词法层刻意宽松），留此分支只为不静默吞掉意外异常。
    -- 归 E-PARSE-012（解析阶段兜底）而不是某个 E-LEX-*：这里拿到的是 Lua 的异常，
    -- 说明的是"没能给出更具体原因"，不是某个确定的词法条件。
    return nil, "E-PARSE-012 sml: 词法阶段异常: " .. tostring(toks)
  end
  local fragments = {}
  -- 契约表（`@contract` 定义 → `@is` 应用）：与解析器共用同一份，见上方 W20 一节。
  -- 须与 fragments 一样是**每次 load 新建**的局部表，否则跨文档会串味。
  local contracts = {}
  local ok2, node = pcall(function()
    -- 顶层支持三种形态，与 dump 的输出对称：
    --   - `[ ... ]` 数组：dump 对数组输出顶层数组（如「历史记录」这类对象数组）。
    --     此前顶层只认键值块，导致能序列化却读不回。
    --   - `{ ... }` 顶层对象块
    --   - 键值块（传统形态）
    -- 注：顶层标量不可往返（SML 顶层需为容器），这是格式固有限制。
    -- 三个顶层入口一律从 depth = 0（文档根）开始，与 Sml 的「128 层」口径一致。
    local first = toks[1]
    if first == "[" then
      return (select(1, parse_array(toks, 2, fragments, contracts, 0)))
    elseif first == "{" then
      return (select(1, parse_block(toks, 2, "}", fragments, contracts, 0)))
    end
    return (select(1, parse_block(toks, 1, nil, fragments, contracts, 0)))
  end)
  if not ok2 then
    -- 已经带码的（fail 抛出的）**原样透出**：它比外层包装具体得多。
    -- 不带码的才归 E-PARSE-012（解析阶段兜底）。看到这个码就是个信号：
    -- 那里上下文不足，应当单独改进，而不是靠扩大兜底范围把问题盖住。
    local m = tostring(node)
    if has_code(m) then return nil, m end
    return nil, "E-PARSE-012 sml: 解析失败: " .. m
  end
  return node, nil
end

------------------------------------------------------------------------------
-- 序列化：dump（round-trip 友好）
------------------------------------------------------------------------------
local function dump_value(v, indent, out)
  indent = indent or 0
  local pad = string.rep("  ", indent)
  local t = type(v)
  if t == "table" then
    if v.__type or #v > 0 and v[1] ~= nil then
      -- 数组（有整数键）或块
      local is_arr = true
      for k in pairs(v) do if type(k) ~= "number" then is_arr = false; break end end
      if is_arr and v.__type == nil then
        out[#out+1] = "["
        for _, e in ipairs(v) do
          out[#out+1] = string.rep("  ", indent+1)
          if type(e) == "table" then
            out[#out+1] = "{ "
            dump_inline(e, out)
            out[#out+1] = " }\n"
          else
            out[#out+1] = tostring(e) .. "\n"
          end
        end
        out[#out+1] = pad .. "]"
        return
      end
    end
    -- 块/对象
    local has_body = false
    for k, val in pairs(v) do
      if k ~= "__type" and k ~= "__name" then has_body = true; break end
    end
    if not has_body then
      out[#out+1] = "{}"
      return
    end
    out[#out+1] = "\n" .. pad .. "{"
    for k, val in pairs(v) do
      if k ~= "__type" and k ~= "__name" then
        out[#out+1] = "\n" .. pad .. "  " .. tostring(k) .. ": "
        dump_value(val, indent + 1, out)
      end
    end
    out[#out+1] = "\n" .. pad .. "}"
  elseif t == "string" then
    -- 含空格或特殊字符加引号
    if string.match(v, "%s") or v == "" then
      out[#out+1] = '"' .. v .. '"'
    else
      out[#out+1] = v
    end
  elseif t == "boolean" then
    out[#out+1] = v and "true" or "false"
  elseif t == "nil" then
    out[#out+1] = "null"
  else
    out[#out+1] = tostring(v)
  end
end

function dump_inline(e, out)
  local parts = {}
  for k, val in pairs(e) do
    if k ~= "__type" and k ~= "__name" then
      local s
      if type(val) == "string" and not string.match(val, "%s") then s = tostring(k) .. ": " .. val
      elseif type(val) == "string" then s = tostring(k) .. ': "' .. val .. '"'
      elseif type(val) == "table" then s = tostring(k) .. ": {..}"  -- 不嵌套内联
      else s = tostring(k) .. ": " .. tostring(val) end
      parts[#parts+1] = s
    end
  end
  out[#out+1] = table.concat(parts, ", ")
end

-- 判定是否为「纯数组表」：键全为连续整数 1..n 且无 __type
local function is_array_table(v)
  if type(v) ~= "table" or v.__type ~= nil then return false end
  local n = 0
  for k in pairs(v) do
    if type(k) ~= "number" or k ~= math.floor(k) or k < 1 then return false end
    if k > n then n = k end
  end
  for i = 1, n do if v[i] == nil then return false end end
  return n > 0
end

function Sml.dump(v)
  -- 顶层数组直接走数组语法 `[ ... ]`，与 Rust/JS/C 实现对齐。
  -- 此前会退化成键值形式输出 `1: { ... }`，导致 dump 与 load 不对称。
  if is_array_table(v) then
    local out = { "[\n" }
    for _, e in ipairs(v) do
      out[#out+1] = "  "
      if type(e) == "table" then
        out[#out+1] = "{ "
        dump_inline(e, out)
        out[#out+1] = " }\n"
      else
        dump_value(e, 1, out)
        out[#out+1] = "\n"
      end
    end
    out[#out+1] = "]\n"
    return table.concat(out)
  end
  local out = {}
  for k, val in pairs(v) do
    if k ~= "__type" and k ~= "__name" then
      out[#out+1] = tostring(k) .. ": "
      dump_value(val, 0, out)
      out[#out+1] = "\n"
    end
  end
  return table.concat(out)
end

return Sml
